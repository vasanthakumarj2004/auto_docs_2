# Disable GoDaddy auto-injected tracking scripts
<IfModule mod_env.c>
  SetEnv TCCL_DISABLED 1
</IfModule>

# =======================================================================
# High-Performance Caching & Compression (.htaccess)
# Eliminates Lighthouse "Use efficient cache lifetimes"
# =======================================================================

# 1. Enable Compression (Gzip / Deflate)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf font/woff font/woff2 application/font-woff application/font-woff2
  <FilesMatch "\.(css|js|html|json|svg|txt)$">
    SetOutputFilter DEFLATE
  </FilesMatch>
</IfModule>

# 2. Leverage Browser Caching (1 Year for Static Assets, Revalidate for HTML)
<IfModule mod_expires.c>
  ExpiresActive On

  # Default expiration
  ExpiresDefault "access plus 1 month"

  # HTML documents (always fresh)
  ExpiresByType text/html "access plus 0 seconds"

  # CSS, JavaScript
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"

  # Images
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"

  # Media (Videos & Audio)
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"

  # Web Fonts
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# 3. Explicit Cache-Control Headers
<IfModule mod_headers.c>
  # 1-year immutable cache for versioned/static assets
  <FilesMatch "\.(css|js|webp|png|jpg|jpeg|gif|ico|svg|mp4|webm|woff|woff2|ttf|otf)$">
    Header onsuccess unset Cache-Control
    Header always unset Cache-Control
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML must revalidate
  <FilesMatch "\.(html|htm)$">
    Header onsuccess unset Cache-Control
    Header always unset Cache-Control
    Header always set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Security headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Content-Security-Policy "script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com"
</IfModule>

# 4. Canonical 301 Redirects & Clean URL Routing
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow direct access to .well-known and static manifest/JSON files
  RewriteRule ^\.well-known/ard\.json$ /ard.json [L]
  RewriteRule ^\.well-known/ai-catalog\.json$ /ai-catalog.json [L]
  RewriteRule ^\.well-known/ - [L]
  RewriteRule ^(ai-catalog\.json|ard\.json|llms\.txt|llms-full\.txt|robots\.txt|sitemap\.xml)$ - [L]

  # Next.js RSC prefetch routing (fallback to directory or index.txt if flat file not found)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^events/iics-2026/__next.*\.txt$ events/iics-2026/__next.events/iics-2026/__PAGE__.txt [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.+)/__next\.([^/]+)[\._]+PAGE__\.txt$ $1/__next.$2/__PAGE__.txt [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1/index.txt -f
  RewriteRule ^(.+)/__next\..+\.txt$ $1/index.txt [L]

  # 301 Redirects: Email & RFQ to Canonical Lowercase
  RewriteRule ^demo/demo-form/?$ /demo-form [R=301,L]
  RewriteRule ^(email-to-booking|rfq-to-booking|RFQ-to-booking)/?$ /logistics-desk/rfq-to-booking/ [R=301,L,NC]
  RewriteRule ^logistics/(email-to-booking|rfq-to-booking|RFQ-to-booking)/?$ /logistics-desk/rfq-to-booking/ [R=301,L,NC]
  RewriteRule ^logistics-desk/(email-to-booking|RFQ-to-booking)/?$ /logistics-desk/rfq-to-booking/ [R=301,L]

  # 301 Redirects: Integration anchor shortcuts (NE flag preserves # from being URL-encoded to %23)
  RewriteRule ^(finance-desk/)?integration-tally/?$ /finance-desk/#integration-tally [R=301,NE,L]
  RewriteRule ^(finance-desk/)?integration-zoho/?$ /finance-desk/#integration-zoho [R=301,NE,L]
  RewriteRule ^(finance-desk/)?integration-erp/?$ /finance-desk/#integration-erp [R=301,NE,L]

  # 301 Redirects: Finance aliases
  RewriteRule ^finance-desk/invoice-automation/?$ /finance-desk/invoice-processing/ [R=301,L]
  RewriteRule ^invoice-processing/?$ /finance-desk/invoice-processing/ [R=301,L]
  RewriteRule ^accounts-payable/?$ /finance-desk/accounts-payable/ [R=301,L]
  RewriteRule ^business-owners/?$ /finance-desk/business-owners/ [R=301,L]
  RewriteRule ^finance-teams/?$ /finance-desk/finance-teams/ [R=301,L]
  RewriteRule ^accounts-teams/?$ /finance-desk/accounts-teams/ [R=301,L]
  RewriteRule ^ca-firms/?$ /finance-desk/ca-firms/ [R=301,L]

  # 301 Redirects: Logistics module aliases
  RewriteRule ^shipment-operations/?$ /logistics-desk/shipment-operations/ [R=301,L]
  RewriteRule ^shipment-tracking/?$ /logistics-desk/shipment-tracking/ [R=301,L]
  RewriteRule ^freight-intelligence/?$ /logistics-desk/freight-intelligence/ [R=301,L]
  RewriteRule ^integrations/?$ /logistics-desk/integrations/ [R=301,L]

  # 301 Redirects: Section wildcards
  RewriteRule ^logistics/?$ /logistics-desk/ [R=301,L]
  RewriteRule ^logistics/(.+)$ /logistics-desk/$1 [R=301,L]
  RewriteRule ^finance/?$ /finance-desk/ [R=301,L]
  RewriteRule ^finance/(.+)$ /finance-desk/$1 [R=301,L]
  RewriteRule ^blog/?$ /blogs/ [R=301,L]
  RewriteRule ^blog/(.+)$ /blogs/$1 [R=301,L]

  # Handle trailing slash and directory index
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)/?$ $1/index.html [L]
</IfModule>
