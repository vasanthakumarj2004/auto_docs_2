# =============================================================================
# Docsynecx Google Analytics 4 (GA4) Environment Configuration
# =============================================================================
# Use a SEPARATE Measurement ID for each environment (dev, staging, production).
# Never hardcode a Measurement ID in source code.

# ---------------------------------------------------------------------------
# CLIENT-SIDE (safe to expose to browser — must be prefixed with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------

# GA4 Measurement ID for this environment
# Development: G-DEVXXXXXXX  |  Staging: G-STAGEXXXXX  |  Production: G-5WXXVPGWG6
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-5WXXVPGWG6

# Application environment identifier attached to every GA4 event as 'app_env'
# Allowed values: development | staging | production
NEXT_PUBLIC_APP_ENV=development

# GA4 Client Debug Mode
# When 'true', logs formatted payloads to the browser console and appends debug_mode: true
# so events appear immediately in GA4 Admin -> DebugView.
# Set to 'true' in development and staging. Set to 'false' in production.
NEXT_PUBLIC_GA_DEBUG_MODE=true

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY (NEVER prefix with NEXT_PUBLIC_ — NEVER expose to browser)
# ---------------------------------------------------------------------------

# GA4 Measurement Protocol API Secret
# Required for server-to-server events (invoice_processed, processing_failed, export_completed).
# Generate via: GA4 Admin -> Data Streams -> Web Stream -> Measurement Protocol API secrets -> Create
GA_API_SECRET=your_server_only_ga_api_secret_here

# ---------------------------------------------------------------------------
# Supabase & Application Secrets (existing)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
